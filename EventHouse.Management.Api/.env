# --- Global Settings ---
IDEMPOTENCY_PROVIDER=PostgreSQL
# PostgreSQL Default DB (for healthchecks)
POSTGRES_DB=eventhouse_core
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin_password_123
POSTGRES_PORT=5433

# --- Database Names ---
MANAGEMENT_DB=management_db
IDEMPOTENCY_DB=idempotency_db

# --- Redis Settings ---
REDIS_PASSWORD=redis_password_456

# --- Generic Idempotency Connection ---
# If PostgreSQL: Host=postgres;Port=5432;Database=${IDEMPOTENCY_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
# If Redis: redis:6379,password=${REDIS_PASSWORD},ssl=false
IDEMPOTENCY_CONNECTION=Host=postgres;Port=5432;Database=idempotency_db;Username=admin;Password=admin_password_123