{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ManagementConnection": "Host=localhost;Port=5432;Database=eventhouse_management;Username=postgres;Password=1234",
    "Idempotency": "Host=localhost;Port=5432;Database=idempotency_db;Username=postgres;Password=1234"
  },
  "Idempotency": {
    "Enabled": true,
    "Provider": "PostgreSQL",
    "AllowedMethods": [ "POST", "PUT", "DELETE" ],
    "HeaderName": "X-Idempotency-Key",
    "Expiration": "6:00:00",
    "MeterName": "FGutierrez.Core.Idempotency"
  },
  "OpenTelemetry": {
    "Tracing": {
      "Enabled": false,
      "OtlpEndpoint": "http://localhost:4317"
    },
    "Metrics": {
      "Enabled": false,
      "OtlpEndpoint": "http://localhost:4317",
      "Meters": [
        "FGutierrez.Core.Idempotency"
      ]
    },
    "Logging": {
      "Enabled": false,
      "OtlpEndpoint": "http://localhost:4317"
    }
  },
  "Auth": {
    "Issuer": "EventHouse.Management.Api",
    "Audience": "EventHouse.Management.Clients",
    "DevSecret": "YourLongSecureSecretKeyHere123!_ExtraCharactersForSecurity"
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "WindowSeconds": 60,
    "QueueLimit": 0
  }
}