{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ManagementConnection": "Host=localhost;Port=5432;Database=eventhouse_management;Username=postgres;Password=1234"
  },
  "RedisConnections": {
    "MainRedis": {
      "Host": "localhost:6379",
      "Password": "foobared",
      "Database": 0,
      "Ssl": false
    }
  },
  "PostgreSqlConnections": {
    "MainPostgreSql": {
      "ConnectionString": "Host=localhost;Port=5433;Database=idempotency_db;Username=admin;Password=admin_password_123"
    }
  },
  "Core": {
    "Cache": {
      "DefaultProvider": "Memory",
      "InstanceName": "CoreSystem:App01"
    },
    "Resilience": {
      "Pipelines": {
        "Sql": {
          "Retry": {
            "MaxRetryAttempts": 2,
            "Delay": "00:00:01",
            "BackoffType": "Exponential",
            "IncludeInnerExceptions": true
          },
          "CircuitBreaker": {
            "FailureRatio": 0.5,
            "SamplingDuration": "00:01:00",
            "MinimumThroughput": 20,
            "BreakDuration": "00:00:30",
            "IncludeInnerExceptions": true
          },
          "Timeout": {
            "Timeout": "00:00:30"
          }
        },
        "Redis": {
          "Retry": {
            "MaxRetryAttempts": 1,
            "Delay": "00:00:00.100",
            "BackoffType": "Exponential"
          },
          "CircuitBreaker": {
            "FailureRatio": 0.5,
            "SamplingDuration": "00:00:30",
            "MinimumThroughput": 10,
            "BreakDuration": "00:00:15"
          },
          "Timeout": {
            "Timeout": "00:00:02"
          }
        }
      }
    },
    "Idempotency": {
      "Enabled": false,
      "Provider": "Redis",
      "AllowedMethods": [
        "POST"
      ],
      "InstanceName": "EventHouse.Management:App01",
      "Expiration": "01:00:00",
      "Fingerprint": {
        "Enabled": true,
        "IncludeQueryString": true,
        "IncludeContentType": true,
        "IncludedHeaders": [
          "Accept",
          "X-Tenant-Id"
        ]
      }
    }
  },
  "OpenTelemetry": {
    "Tracing": {
      "Enabled": false,
      "OtlpEndpoint": "http://localhost:4317"
    },
    "Metrics": {
      "Enabled": false,
      "OtlpEndpoint": "http://localhost:4317"
    },
    "Logging": {
      "Enabled": false,
      "OtlpEndpoint": "http://localhost:4317"
    }
  },
  "Auth": {
    "Issuer": "EventHouse.Management.Api",
    "Audience": "EventHouse.Management.Clients",
    "DevSecret": "YourLongSecureSecretKeyHere123!_ExtraCharactersForSecurity"
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "WindowSeconds": 60,
    "QueueLimit": 0
  }
}