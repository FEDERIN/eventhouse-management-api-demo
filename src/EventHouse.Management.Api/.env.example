# Docker infrastructure
POSTGRES_DB=eventhouse_core
POSTGRES_USER=eventhouse
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_PORT=5433
MANAGEMENT_DB=eventhouse_management
IDEMPOTENCY_DB=idempotency_db
REDIS_PASSWORD=replace-with-a-local-redis-password
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-local-grafana-password

# Application configuration. These names map directly to ASP.NET configuration.
ConnectionStrings__ManagementConnection=Host=postgres;Port=5433;Database=eventhouse_management;Username=eventhouse;Password=replace-with-a-local-postgres-password
PostgreSqlConnections__MainPostgreSql__ConnectionString=Host=postgres;Port=5433;Database=idempotency_db;Username=eventhouse;Password=replace-with-a-local-postgres-password
RedisConnections__MainRedis__Host=redis:6379
RedisConnections__MainRedis__Password=replace-with-a-local-redis-password
RedisConnections__MainRedis__Database=0
RedisConnections__MainRedis__Ssl=false

Auth__Issuer=EventHouse.Management.Api
Auth__Audience=EventHouse.Management.Clients
Auth__DevSecret=replace-with-a-development-secret-of-at-least-32-characters
# Temporary demo token endpoint. Keep disabled outside local/manual testing.
Auth__DemoToken__Enabled=false

# Google Identity Services (public client identifier; do not add a client secret)
Google__ClientId=replace-with-your-client-id.apps.googleusercontent.com
Google__Authority=https://accounts.google.com
# Set this after your first Google sign-in; this account becomes the first Admin.
# Authorization__BootstrapAdminGoogleSubject=your-google-subject

Core__Cache__Provider=Redis
Core__Cache__InstanceName=EventHouse.Management:App01
Core__Idempotency__Enabled=true
Core__Idempotency__Provider=PostgreSql
Core__Idempotency__HeaderName=Idempotency-Key
Core__Idempotency__Expiration=06:00:00
Core__RateLimiting__PermitLimit=60
Core__RateLimiting__Window=00:01:00
Core__RateLimiting__QueueLimit=0

OpenTelemetry__Tracing__Enabled=false
OpenTelemetry__Tracing__OtlpEndpoint=http://localhost:4317
OpenTelemetry__Metrics__Enabled=false
OpenTelemetry__Metrics__OtlpEndpoint=http://localhost:4317
OpenTelemetry__Logging__Enabled=false
OpenTelemetry__Logging__OtlpEndpoint=http://localhost:4317

# Optional package license. Keep the actual value only in the ignored .env file.
MEDIATR_LICENSE_KEY=replace-with-your-mediatr-license-key

# Optional: IP addresses of reverse proxies allowed to set X-Forwarded-* headers.
# ReverseProxy__KnownProxies__0=203.0.113.10


Google__ClientId=***************.apps.googleusercontent.com
Google__Authority=https://accounts.google.com
